  /* Responsive */
  @media (max-width: 768px) {
    padding: 16px;

    .product-list-item {
      flex-direction: column;
      padding: 12px;
      gap: 12px;
    }

    .product-list-image {
      width: 100%;
      height: 200px;
    }

    .product-list-content {
      .product-list-title {
        font-size: 18px;
      }

      .product-list-description p {
        max-width: none;
      }
    }
  }

  @media (max-width: 480px) {
    .product-list-item {
      box-shadow: 6px 6px 0 0 #012f6d;
    }

    .product-list-info {
      gap: 10px;

      .info-item {
        font-size: 12px;

        img {
          width: 16px;
          height: 16px;
        }
      }
    }
  }


  
