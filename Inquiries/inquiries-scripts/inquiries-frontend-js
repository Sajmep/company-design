// Modal functions
function createInquiry() {
    document.getElementById('createInquiryModal').style.display = 'flex';
}

function closeCreateInquiryModal() {
    document.getElementById('createInquiryModal').style.display = 'none';
}

function showTab(type) {
    // Update tab buttons
    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('active');
    });
    event.target.classList.add('active');
    
    // Show/hide tab content
    document.getElementById('quickInquiryTab').classList.remove('active');
    document.getElementById('advancedInquiryTab').classList.remove('active');
    
    if (type === 'quick') {
        document.getElementById('quickInquiryTab').classList.add('active');
    } else {
        document.getElementById('advancedInquiryTab').classList.add('active');
    }
}

// Close modal when clicking outside
document.getElementById('createInquiryModal').addEventListener('click', function (e) {
    if (e.target === this) {
        closeCreateInquiryModal();
    }
});

// Simple autocomplete for presentation
function initializeAutocomplete(inputId, dropdownId) {
    const input = document.getElementById(inputId);
    const dropdown = document.getElementById(dropdownId);
    
    // Show dropdown when clicking inside the field
    input.addEventListener('focus', function() {
        dropdown.classList.add('show');
    });
    
    // Show dropdown when typing
    input.addEventListener('input', function() {
        if (this.value.trim() !== '') {
            dropdown.classList.add('show');
        } else {
            dropdown.classList.add('show'); // Keep showing even when empty
        }
    });
    
    // Hide dropdown when clicking outside
    document.addEventListener('click', function(e) {
        if (!e.target.closest('.autocomplete-container')) {
            dropdown.classList.remove('show');
        }
    });
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
    initializeAutocomplete('quickProject', 'quickProjectDropdown');
    initializeAutocomplete('advancedProject', 'advancedProjectDropdown');
});